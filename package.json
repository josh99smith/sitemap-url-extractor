{
    "name": "sitemap-url-extractor",
    "version": "0.0.1",
    "type": "module",
    "description": "Extract every URL from a website's XML sitemaps: discovers sitemaps via robots.txt and common paths, follows sitemap indexes, reads .xml.gz files and returns lastmod, changefreq, priority and hreflang alternates.",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "apify": "^3.7.0",
        "fast-xml-parser": "^5.11.1",
        "got-scraping": "^4.2.1"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "@apify/tsconfig": "^0.2.0",
        "@types/node": "^24.0.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "globals": "^17.0.0",
        "prettier": "^3.5.3",
        "tsx": "^4.20.3",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.58.0",
        "vitest": "^5.0.0"
    },
    "scripts": {
        "start": "npm run start:dev",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run"
    },
    "author": "Josh Smith",
    "license": "MIT"
}
